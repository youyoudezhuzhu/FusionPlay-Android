#!/bin/bash
# cmd/main — start / stop / restart / status（status 严格 0=运行中 / 3=未运行）
APP="${TRIM_APPDEST:-/var/apps/fusionplay-fnos/target}"
VAR="${TRIM_PKGVAR:-/vol1/@appdata/fusionplay-fnos}"
PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/fusionplay-fnos}"
PORT="${TRIM_SERVICE_PORT:-18080}"
BIN="$APP/bin/fusionplay-fnos"
WWW="$APP/www"
LOG="$VAR/app.log"
PID_FILE="$VAR/app.pid"
SOCK="$APP/fusionplay-fnos.sock"

export HOME="$PKGHOME"                                   # 无条件覆盖（fnOS 注入 HOME=/root）
export DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH:-$VAR}"
export TRIM_SERVICE_PORT="$PORT"
export GATEWAY_SOCKET="$SOCK"
export GATEWAY_PREFIX="/app/fusionplay-fnos"
mkdir -p "$VAR" "$PKGHOME" 2>/dev/null || true

trim_log() {
    local file="$1" size tmp max keep
    max="${LOG_MAX_BYTES:-5242880}"
    keep="${LOG_KEEP_BYTES:-1048576}"
    [ -f "$file" ] || return 0
    size=$(stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$size" -le "$max" ]; then return 0; fi
    tmp="$file.trim"
    tail -c "$keep" "$file" > "$tmp" 2>/dev/null || return 0
    cat "$tmp" > "$file" 2>/dev/null || true   # 原地重写，保持 inode
    rm -f "$tmp"
}
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null; trim_log "$LOG"; }

is_running() {
    local pid=""
    [ -f "$PID_FILE" ] && pid="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

health() {
    curl -fsS --max-time 2 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1
}

start() {
    if is_running && health; then log "already running pid=$(cat "$PID_FILE")"; return 0; fi
    if is_running; then
        log "stale pid $(cat "$PID_FILE"); restarting"
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        sleep 1
    fi
    rm -f "$SOCK" "$PID_FILE"
    chmod +x "$BIN" 2>/dev/null || true
    [ -x "$BIN" ] || { log "missing binary: $BIN"; return 1; }
    log "starting $("$BIN" --version 2>/dev/null) port=$PORT home=$HOME var=$VAR"
    nohup "$BIN" --config "$PKGHOME/config.json" --state-dir "$VAR" --www "$WWW" \
        --listen-tcp "127.0.0.1:$PORT" --listen-unix "$SOCK" >> "$LOG" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    for _ in $(seq 1 40); do
        if health; then
            log "started pid=$pid (health ok)"
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            log "start failed: process exited; see $LOG"
            rm -f "$PID_FILE"
            return 1
        fi
        sleep 0.25
    done
    log "start pid=$pid but health check timed out"
    return 1
}

stop() {
    local pid=""
    [ -f "$PID_FILE" ] && pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        log "stopping pid=$pid"
        kill "$pid" 2>/dev/null
        for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
        kill -9 "$pid" 2>/dev/null || true
    fi
    pkill -f "$BIN" 2>/dev/null || true
    rm -f "$PID_FILE" "$SOCK"
    log "stopped"
    return 0
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) if is_running; then exit 0; else exit 3; fi ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
