#!/bin/bash
APP="${TRIM_APPDEST:-/var/apps/fusionplay-fnos/target}"
"$APP/cmd/main" stop >/dev/null 2>&1 || true
# 兜底：清理可能残留的旧进程（按应用路径匹配，绝不 pkill 系统 python）
pkill -f "$APP/bin/fusionplay-fnos" 2>/dev/null || true
rm -f "${TRIM_PKGVAR:-/vol1/@appdata/fusionplay-fnos}/app.pid" 2>/dev/null || true
exit 0
