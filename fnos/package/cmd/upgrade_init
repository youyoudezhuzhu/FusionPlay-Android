#!/bin/bash
# upgrade_init — 升级前【必须停掉旧服务】。
#
# 若这里不停服务：target/ 换成新代码后，旧进程仍在内存里跑旧代码并占着端口，
# 新进程 bind 失败退出 → 应用中心显示「运行中」，实际一直是旧版本
# （总纲 §5.5「升级后功能没变」最隐蔽的故障）。
#
# 这里做三层兜底：
#   1. 调 cmd/main stop（带 PID 文件正常停）；
#   2. 按【精确二进制路径】清理本应用残留进程；
#   3. 按端口兜底清理（只 kill 能确认属于本应用的 PID，绝不误杀他人）。
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
APP="${TRIM_APPDEST:-/var/apps/fusionplay-fnos/target}"
VAR="${TRIM_PKGVAR:-/vol1/@appdata/fusionplay-fnos}"
PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/fusionplay-fnos}"
PORT="${TRIM_SERVICE_PORT:-18080}"
BIN="$APP/bin/fusionplay-fnos"
PID_FILE="$VAR/app.pid"
SOCK="$APP/fusionplay-fnos.sock"

export HOME="$PKGHOME"
export DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH:-$VAR}"
mkdir -p "$VAR" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$VAR/app.log" 2>/dev/null || true; }

# 只认命令行里精确包含本应用二进制路径的进程
is_ours() {
    local pid="$1" cmdline=""
    [ -r "/proc/$pid/cmdline" ] || return 1
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$cmdline" in *"$BIN"*) return 0 ;; esac
    return 1
}
port_pids() {
    command -v ss >/dev/null 2>&1 || return 0
    ss -H -lntp 2>/dev/null | awk -v p=":$PORT" '$4 ~ (p "$") {print}' \
        | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
}
port_busy() {
    command -v ss >/dev/null 2>&1 || return 1
    ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}\$"
}

log "upgrade_init：准备升级，停止旧版本服务（port=$PORT）"

CMD_MAIN=""
for c in "$SELF_DIR/main" "$SELF_DIR/../cmd/main" "/var/apps/${TRIM_APPNAME:-fusionplay-fnos}/cmd/main"; do
    if [ -f "$c" ]; then CMD_MAIN="$c"; break; fi
done
if [ -n "$CMD_MAIN" ]; then
    /bin/bash "$CMD_MAIN" stop >/dev/null 2>&1 || true
else
    log "upgrade_init：找不到 cmd/main，改用精确路径/端口兜底"
fi

# 兜底 1：精确二进制路径
pkill -f -- "$BIN" 2>/dev/null || true

# 兜底 2：端口占用者（仅本应用）
for round in 1 2; do
    left=""
    for p in $(port_pids); do
        is_ours "$p" && left="$left $p"
    done
    [ -z "$left" ] && break
    log "upgrade_init：清理残留进程$left（第 $round 轮）"
    if [ "$round" = "1" ]; then
        # shellcheck disable=SC2086
        kill -TERM $left 2>/dev/null || true
    else
        # shellcheck disable=SC2086
        kill -KILL $left 2>/dev/null || true
    fi
    sleep 1
done

# 等端口真正释放（最多 5s）
for _ in $(seq 1 25); do
    port_busy || break
    sleep 0.2
done

rm -f "$PID_FILE" "$SOCK" 2>/dev/null || true

if port_busy; then
    log "upgrade_init：警告——端口 $PORT 仍被占（非本应用进程？），新版本可能无法启动"
fi
log "upgrade_init：旧服务已停止，PID/socket 已清理"
exit 0
