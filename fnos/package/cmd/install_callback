#!/bin/bash
# install_callback — 安装文件落盘后初始化：建数据目录、补可执行位、首次启动并验证 /healthz。
#
# 注意：cmd/ 脚本在真机上位于 /var/apps/<app>/cmd，而 $TRIM_APPDEST 指向
# /vol1/@appcenter/<app>（app.tgz 的内容），所以**不能**用 "$TRIM_APPDEST/cmd/main"。
# 这里用 $0 同目录定位 main（模拟安装与真机安装都成立）。
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
APP="${TRIM_APPDEST:-/var/apps/fusionplay-fnos/target}"
VAR="${TRIM_PKGVAR:-/vol1/@appdata/fusionplay-fnos}"
PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/fusionplay-fnos}"
ERRLOG="${TRIM_TEMP_LOGFILE:-$VAR/install-error.log}"

export HOME="$PKGHOME"
export DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH:-$VAR}"
mkdir -p "$VAR" "$PKGHOME" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$VAR/app.log" 2>/dev/null || true; }
fail() {
    log "install_callback 失败: $1"
    mkdir -p "$(dirname "$ERRLOG")" 2>/dev/null || true
    printf '%s\n' "FusionPlay 安装失败：$1" > "$ERRLOG" 2>/dev/null || true
    exit 1
}

# bin/ 里的文件经上传/解包后经常丢执行位，补回来
for f in "$APP"/bin/*; do [ -f "$f" ] && chmod +x "$f" 2>/dev/null; done

CMD_MAIN="$SELF_DIR/main"
[ -f "$CMD_MAIN" ] || fail "安装包缺少 cmd/main，无法启动服务（请重新下载完整的 .fpk）"

VERSION="unknown"
[ -f "$SELF_DIR/../manifest" ] && VERSION="$(grep -m1 '^version' "$SELF_DIR/../manifest" | cut -d= -f2- | tr -d ' "')"
log "install_callback 开始：version=${VERSION:-unknown} var=$VAR home=$PKGHOME"

# 主动试启动一次：服务型应用装完即用；fnOS 随后若还会调 main start，那是幂等的。
# 注意（总纲 §5 / 应用中心实测）：install_callback 失败会让应用中心判定「安装失败」，
# 所以这里启动失败【不】非 0 退出，而是写 $TRIM_TEMP_LOGFILE 让用户在界面上看到原因；
# 真正的启动失败会在 /healthz、upgrade_callback 与日志里继续暴露，不会被静默吞掉。
if ! /bin/bash "$CMD_MAIN" start; then
    log "install_callback：服务首次启动失败，已写入 $ERRLOG（安装继续，用户可手动启动重试）"
    mkdir -p "$(dirname "$ERRLOG")" 2>/dev/null || true
    printf '%s\n' "FusionPlay 已安装，但服务首次启动失败。请查看 $VAR/app.log；常见原因：端口 18080 被占用、二进制缺少执行权限。可稍后在应用中心手动启动。" > "$ERRLOG" 2>/dev/null || true
else
    log "install_callback 完成：服务已启动并通过 /healthz"
fi
exit 0
