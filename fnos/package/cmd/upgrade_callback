#!/bin/bash
# upgrade_callback — 升级后【必须重新拉起服务】（upgrade_init 已经把旧进程停了）。
#
# 失败不能静默：写 $TRIM_TEMP_LOGFILE（应用中心会展示给用户）并非 0 退出，
# 否则会出现「升级成功」但服务一直停着的假象。
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
APP="${TRIM_APPDEST:-/var/apps/fusionplay-fnos/target}"
VAR="${TRIM_PKGVAR:-/vol1/@appdata/fusionplay-fnos}"
PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/fusionplay-fnos}"
ERRLOG="${TRIM_TEMP_LOGFILE:-$VAR/upgrade-error.log}"

export HOME="$PKGHOME"
export DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH:-$VAR}"
mkdir -p "$VAR" "$PKGHOME" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$VAR/app.log" 2>/dev/null || true; }
fail() {
    log "upgrade_callback 失败: $1"
    mkdir -p "$(dirname "$ERRLOG")" 2>/dev/null || true
    printf '%s\n' "FusionPlay 升级已完成，但$1。请在应用中心手动启动一次；若仍失败请查看 $VAR/app.log。" > "$ERRLOG" 2>/dev/null || true
    exit 1
}

# 新版二进制可能因打包/上传丢执行位
for f in "$APP"/bin/*; do [ -f "$f" ] && chmod +x "$f" 2>/dev/null; done

CMD_MAIN=""
for c in "$SELF_DIR/main" "$SELF_DIR/../cmd/main" "/var/apps/${TRIM_APPNAME:-fusionplay-fnos}/cmd/main"; do
    if [ -f "$c" ]; then CMD_MAIN="$c"; break; fi
done
[ -n "$CMD_MAIN" ] || fail "找不到启动脚本 cmd/main"

log "upgrade_callback：重新拉起新版本服务"
if ! /bin/bash "$CMD_MAIN" start; then
    fail "服务未能自动启动（可能端口被占用或二进制无法运行）"
fi
log "upgrade_callback 完成：新版本已启动并通过 /healthz"
exit 0
