# fnOS / FPK manifest（INI，字段名必须使用官方字段）
# 规范依据：fnOS FPK 开发方法总纲 §2.2
#   - platform 不是 arch（值：x86 / arm / all；含架构特定二进制时必须写具体架构）
#   - desc 不是 description；maintainer 不是 developer；service_port 不是 port
#   - source 第三方固定 thirdparty
# 本包内含 x86_64 ELF（fnos/backend release 构建），因此 platform = x86；ARM 版需交叉编译后再出包。
appname               = fusionplay-fnos
version               = 0.2.4
display_name          = "FusionPlay"
desc                  = "把 AirPlay 2 / DLNA / 小米妙播音频接到飞牛 NAS 的音频输出设备（多声卡、发送端主音量、校准）"
source                = thirdparty
platform              = x86
maintainer            = "youyoudezhuzhu"
maintainer_url        = https://github.com/youyoudezhuzhu/FusionPlay-Android
distributor           = "youyoudezhuzhu"
distributor_url       = https://github.com/youyoudezhuzhu/FusionPlay-Android
changelog             = "0.2.4：妙播默认启用旧版固定密钥媒体兼容（修复旧平板投送失败）；AirPlay 改为纯音响广播（不再被识别为 TV/视频目标）；0.2.3：恢复小米妙播设备身份切换（车机/电视/平板/音响，发送端图标随之变化）；0.2.2：修复小米妙播一直显示「启动中」；0.2.1：统一三协议状态文案（等待投放/播放中/已暂停/已关闭/异常），概览与接收页完全同步；0.2.0：四页面浅色/深色 UI 重构；每设备独立音量曲线、响度与延迟；全局仅保留衰减/静音；v1 配置自动迁移"
desktop_uidir         = ui
desktop_applaunchname = fusionplay-fnos.main
service_port          = 18080
checkport             = true
ctl_stop              = true
disable_authorization_path = true
os_min_version        = 1.0.0
